{
  "name": "fludo-supplies-erp",
  "version": "1.4.0",
  "private": true,
  "description": "Building-Materials Yard ERP (Offline-First Windows Desktop + PostgreSQL) for Fludo Supplies",
  "workspaces": [
    "services/api",
    "apps/ui",
    "apps/desktop"
  ],
  "scripts": {
    "start:db": "powershell -ExecutionPolicy Bypass -File scripts/start_db.ps1",
    "dev:api": "npm --workspace=services/api run dev",
    "dev:ui": "npm --workspace=apps/ui run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ui\"",
    "build:api": "npm --workspace=services/api run build",
    "build:ui": "npm --workspace=apps/ui run build",
    "build:desktop": "npm --workspace=apps/desktop run build:main",
    "build": "npm run build:api && npm run build:ui && npm run build:desktop",
    "stage": "node scripts/prepare_package.cjs",
    "pack": "npm run build && npm run stage && npm --workspace=apps/desktop run pack:exe",
    "test": "npm --workspace=services/api test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "puppeteer-core": "^25.18.1"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17"
  }
}
