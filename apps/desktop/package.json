{
  "name": "fludo-supplies-erp",
  "version": "1.0.0",
  "description": "Building-Materials Yard ERP for Al-Reda Supplies Co.",
  "main": "dist/main.js",
  "author": "Al-Reda Supplies Co. & Fludo",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "stage": "node ../../scripts/prepare_package.cjs",
    "pack:dir": "electron-builder --dir",
    "pack:exe": "electron-builder --win nsis",
    "dist": "npm run build:main && npm run stage && electron-builder --win nsis"
  },
  "build": {
    "electronVersion": "34.2.0",
    "appId": "com.fludo.supplieserp",
    "productName": "Fludo Supplies ERP",
    "copyright": "Copyright © 2026 Al-Reda Supplies Co.",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "ui/**/*",
      "api/**/*",
      "assets/**/*",
      "db/**/*",
      "0001_initial.sql",
      "0002_fix_constraints_and_search.sql",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fludo Supplies ERP - شركة الرضا"
    }
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "electron": "34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2"
  }
}
