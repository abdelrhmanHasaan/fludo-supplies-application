{
  "name": "fludo-supplies-erp",
  "version": "1.6.0",
  "description": "Building-Materials Yard ERP for Fludo Supplies",
  "main": "dist/main.js",
  "author": "Fludo Supplies",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "stage": "node ../../scripts/prepare_package.cjs",
    "pack:dir": "electron-builder --dir",
    "pack:exe": "electron-builder --win nsis",
    "dist": "npm run --prefix ../.. build && npm run stage && electron-builder --win nsis"
  },
  "build": {
    "electronVersion": "34.2.0",
    "appId": "com.fludo.supplieserp",
    "productName": "Fludo Supplies ERP",
    "copyright": "Copyright © 2026 Fludo Supplies",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "asar": false,
    "files": [
      "dist/**/*",
      "ui/**/*",
      "api/**/*",
      "assets/**/*",
      "db/**/*",
      "0001_initial.sql",
      "0002_fix_constraints_and_search.sql",
      "0003_comprehensive_schema_update.sql",
      "0004_figjam_overhaul.sql",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "pgsql",
        "to": "pgsql",
        "filter": [
          "bin/**/*",
          "lib/**/*",
          "share/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fludo Supplies ERP"
    }
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "argon2": "^0.45.2",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "electron": "34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.8.2"
  }
}
